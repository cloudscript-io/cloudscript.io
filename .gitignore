# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata

# Local toolchain
.bundle/
vendor/
node_modules/
package-lock.json
package.json

# Internal project docs & drafts — must NOT enter the public repo / git history
PROJECT_STATUS.md
CLAUDE.md
design-reference/
content-drafts/
.claude/settings.local.json

# macOS Finder and local tool leftovers
.DS_Store
.fuse_hidden*
.playwright-mcp/

# kb-sync (scripts/kb-sync): its manifest and lockfile ARE committed so the workflow can
# `npm ci`; its node_modules never is. These negate the blanket package.json rules above.
!scripts/kb-sync/package.json
!scripts/kb-sync/package-lock.json
scripts/kb-sync/node_modules/
