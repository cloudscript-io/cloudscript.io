---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
{% comment %}
  Atom feed for /news, hand-authored in Liquid so it needs no jekyll-feed plugin (the site
  runs plugin-free; CLAUDE.md §5). Same source as the /news stream: every file in _posts/.
{% endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>CloudScript.io News</title>
  <subtitle>Release announcements and company news from CloudScript.io.</subtitle>
  <id>{{ "/news/" | absolute_url }}</id>
  <link href="{{ "/news/" | absolute_url }}"/>
  <link rel="self" type="application/atom+xml" href="{{ "/news/feed.xml" | absolute_url }}"/>
  <updated>{% if site.posts.size > 0 %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>CloudScript.io</name></author>
{% for post in site.posts limit: 20 %}{% assign app = nil %}{% if post.app %}{% assign app = site.data.apps[post.app] %}{% endif %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <id>{{ post.url | absolute_url }}</id>
    <link href="{{ post.url | absolute_url }}"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% if app %}<category term="{{ app.slug | xml_escape }}" label="{{ app.name | xml_escape }}"/>{% endif %}
    {% if post.description %}<summary>{{ post.description | xml_escape }}</summary>{% endif %}
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
  </entry>
{% endfor %}
</feed>
